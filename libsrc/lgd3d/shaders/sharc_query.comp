#version 460
#extension GL_GOOGLE_include_directive : require
#define SHARC_UPDATE 0
#define SHARC_QUERY 1
#include "sharc_bridge.glsl"
layout(local_size_x=8,local_size_y=8) in;
vec3 queryPath(IndirectSurface root,vec3 direction,inout RTXDI_RandomSamplerState rng,out float firstDistance,bool glossy) {
