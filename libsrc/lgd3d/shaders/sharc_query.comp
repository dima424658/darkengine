    float a=max(root.surface.material.rough*root.surface.material.rough,.002),c=sqrt((1-u)/(1+(a*a-1)*u));
    vec3 n=root.surface.normal,t=normalize(cross(n,abs(n.z)<.9?vec3(0,0,1):vec3(0,1,0)));
    vec3 h=t*(sqrt(max(1-c*c,0))*cos(phi))+cross(n,t)*(sqrt(max(1-c*c,0))*sin(phi))+n*c;
    direction=reflect(-root.surface.view,h);vec3 specular=vec3(0);
