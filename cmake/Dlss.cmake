option(DARK_ENABLE_DLSS "Build optional NVIDIA DLSS Super Resolution support" OFF)
if(NOT DARK_ENABLE_DLSS)
  return()
endif()
if(NOT DARK_ENABLE_RTX_SDK OR ANDROID OR APPLE)
  message(FATAL_ERROR "DLSS requires the RTX world renderer on desktop Linux or Windows")
endif()
set(DARK_DLSS_ROOT "${PROJECT_SOURCE_DIR}/3rdparty/DLSS" CACHE PATH "NVIDIA DLSS SDK")
if(NOT EXISTS "${DARK_DLSS_ROOT}/include/nvsdk_ngx_vk.h")
  message(FATAL_ERROR "Initialize the DLSS SDK: git submodule update --init 3rdparty/DLSS")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
  set(dark_ngx_library "${DARK_DLSS_ROOT}/lib/Linux_x86_64/libnvsdk_ngx.a")
  set(dark_dlss_runtime "${DARK_DLSS_ROOT}/lib/Linux_x86_64/rel/libnvidia-ngx-dlss.so.310.9.16")
elseif(MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(dark_ngx_library "${DARK_DLSS_ROOT}/lib/Windows_x86_64/x64/nvsdk_ngx_s.lib")
  set(dark_dlss_runtime "${DARK_DLSS_ROOT}/lib/Windows_x86_64/rel/nvngx_dlss.dll")
else()
  message(FATAL_ERROR "DLSS currently supports Linux x86-64 and Windows MSVC x64")
endif()
add_library(dark_dlss STATIC "${PROJECT_SOURCE_DIR}/libsrc/lgd3d/vulkan_dlss.cpp")
target_include_directories(dark_dlss SYSTEM PRIVATE "${DARK_DLSS_ROOT}/include")
target_link_libraries(dark_dlss PUBLIC Vulkan::Vulkan PRIVATE "${dark_ngx_library}" ${CMAKE_DL_LIBS})
target_compile_definitions(dark_dlss PRIVATE DARK_DLSS_RUNTIME_DIRECTORY="${PROJECT_BINARY_DIR}")
set(DARK_DLSS_RUNTIME "${dark_dlss_runtime}")
if(WIN32)
  set(DARK_DLSS_RUNTIME_NAME nvngx_dlss.dll)
else()
  set(DARK_DLSS_RUNTIME_NAME libnvidia-ngx-dlss.so)
endif()
configure_file("${DARK_DLSS_RUNTIME}" "${PROJECT_BINARY_DIR}/${DARK_DLSS_RUNTIME_NAME}" COPYONLY)
add_executable(dark_dlss_test EXCLUDE_FROM_ALL "${PROJECT_SOURCE_DIR}/tools/rtx_sdk_test/dlss.cpp")
target_link_libraries(dark_dlss_test PRIVATE dark_lgd3d dark_dlss)
