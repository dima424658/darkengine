# RTXDI's GLSL mode retains a few HLSL implicit conversions. Make those
# conversions explicit in a generated include tree without touching the SDK.
function(dark_prepare_rtxdi_glsl output_dir)
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../3rdparty/RTXDI/Include")
  file(GLOB_RECURSE headers CONFIGURE_DEPENDS RELATIVE "${root}" "${root}/*.h" "${root}/*.hlsli")
  foreach(header IN LISTS headers)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${header}")
    file(READ "${root}/${header}" contents)
    if(header STREQUAL "Rtxdi/Utils/Math.hlsli")
      string(REPLACE "(value << bit)" "(uint(value) << bit)" contents "${contents}")
      string(REPLACE "return (target >> bit) & 1;" "return ((target >> bit) & 1u) != 0u;" contents "${contents}")
    endif()
    if(header MATCHES "Rtxdi/DI/(TemporalResampling|SpatialResampling).hlsli")
      string(REPLACE "!tparams.enablePermutationSampling" "(tparams.enablePermutationSampling == 0u)" contents "${contents}")
      string(REPLACE "tparams.enableFallbackSampling ?" "(tparams.enableFallbackSampling != 0u) ?" contents "${contents}")
      foreach(flag IN ITEMS tparams.enablePermutationSampling tparams.enableVisibilityShortcut sParams.enableMaterialSimilarityTest sParams.discountNaiveSamples)
        string(REPLACE "${flag} &&" "(${flag} != 0u) &&" contents "${contents}")
        string(REPLACE "if (${flag})" "if (${flag} != 0u)" contents "${contents}")
      endforeach()
      string(REPLACE "all(prevSample.spatialDistance == 0)" "all(equal(prevSample.spatialDistance, int2(0)))" contents "${contents}")
    endif()
    set(destination "${output_dir}/${header}")
    get_filename_component(folder "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${folder}")
    set(previous "")
    if(EXISTS "${destination}")
      file(READ "${destination}" previous)
    endif()
    if(NOT contents STREQUAL previous)
      file(WRITE "${destination}" "${contents}")
    endif()
  endforeach()
endfunction()
