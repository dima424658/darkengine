<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Project-only builds do not define SolutionDir.  Keep all of the
         historical solution-relative include and library paths working when
         the shared executable project is built directly. -->
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)</SolutionDir>
    <BuildThief2 Condition="'$(BuildThief2)' == ''">true</BuildThief2>
    <!-- NewDark Squirrel compatibility is part of the normal Windows feature
         set.  The source stays in the sibling dependency checkout; constrained
         builds may opt out explicitly with EnableSquirrel=false. -->
    <EnableSquirrel Condition="'$(EnableSquirrel)' == ''">true</EnableSquirrel>
    <SquirrelSourceDir Condition="'$(SquirrelSourceDir)' == ''">$(MSBuildThisFileDirectory)..\..\darkengine-deps\squirrel\</SquirrelSourceDir>
    <SquirrelSourceRoot>$([MSBuild]::EnsureTrailingSlash('$(SquirrelSourceDir)'))</SquirrelSourceRoot>
    <SquirrelIncludePath Condition="'$(EnableSquirrel)' == 'true'">$(SquirrelSourceRoot)include;</SquirrelIncludePath>
    <!-- KCTools is part of the normal DromEd feature set just as Squirrel is
         part of the normal game set. Constrained editor builds may opt out
         explicitly with EnableKCTools=false. -->
    <EnableKCTools Condition="'$(EnableKCTools)' == ''">true</EnableKCTools>
    <KCToolsSourceDir Condition="'$(KCToolsSourceDir)' == ''">$(MSBuildThisFileDirectory)..\..\darkengine-deps\kctools\</KCToolsSourceDir>
    <KCToolsSourceRoot>$([MSBuild]::EnsureTrailingSlash('$(KCToolsSourceDir)'))</KCToolsSourceRoot>
    <DotNetExecutable Condition="'$(DotNetExecutable)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\darkengine-deps\dotnet10-sdk\dotnet.exe')">$(MSBuildThisFileDirectory)..\..\darkengine-deps\dotnet10-sdk\dotnet.exe</DotNetExecutable>
    <DotNetExecutable Condition="'$(DotNetExecutable)' == ''">dotnet</DotNetExecutable>
    <!-- Ogg Vorbis FM sounds use libsndfile through a runtime-only dynamic
         load. Official architecture-specific releases stay outside the repo. -->
    <EnableSndFileRuntime Condition="'$(EnableSndFileRuntime)' == ''">false</EnableSndFileRuntime>
    <SndFileRuntimeDir Condition="'$(SndFileRuntimeDir)' == '' And '$(Platform)' == 'Win32'">$(MSBuildThisFileDirectory)..\..\darkengine-deps\libsndfile-1.2.2-win32\libsndfile-1.2.2-win32\bin\</SndFileRuntimeDir>
    <SndFileRuntimeDir Condition="'$(SndFileRuntimeDir)' == '' And '$(Platform)' == 'x64'">$(MSBuildThisFileDirectory)..\..\darkengine-deps\libsndfile-1.2.2-win64\libsndfile-1.2.2-win64\bin\</SndFileRuntimeDir>
    <SndFileRuntimeRoot Condition="'$(SndFileRuntimeDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(SndFileRuntimeDir)'))</SndFileRuntimeRoot>
    <!-- Keep all generated files under build, grouped first by configuration
         and then by the MSBuild platform name (Win32 or x64). -->
    <DarkBuildRoot>$(MSBuildThisFileDirectory)build\</DarkBuildRoot>
    <DarkPlatformOutputDir>$(DarkBuildRoot)$(Configuration)\$(Platform)\</DarkPlatformOutputDir>
    <DarkIntermediateRoot>$(DarkBuildRoot)obj\$(Configuration)\$(Platform)\</DarkIntermediateRoot>
    <DarkLibraryOutputDir>$(DarkPlatformOutputDir)</DarkLibraryOutputDir>
    <OutDir>$(DarkPlatformOutputDir)</OutDir>
    <IntDir>$(DarkIntermediateRoot)$(MSBuildProjectName)\</IntDir>
    <IncludePath>$(MSBuildThisFileDirectory)winsrc;$(MSBuildThisFileDirectory)winsrc\appcore;$(MSBuildThisFileDirectory)winsrc\dispdev;$(MSBuildThisFileDirectory)winsrc\editor;$(MSBuildThisFileDirectory)winsrc\gameshel;$(MSBuildThisFileDirectory)winsrc\lg;$(MSBuildThisFileDirectory)winsrc\lgalloc;$(MSBuildThisFileDirectory)winsrc\platform;$(MSBuildThisFileDirectory)winsrc\sound;$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <!-- Dark's persisted structures and cross-library ABI use byte packing. -->
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)winsrc;$(MSBuildThisFileDirectory)winsrc\appcore;$(MSBuildThisFileDirectory)winsrc\editor;$(MSBuildThisFileDirectory)winsrc\lg;$(MSBuildThisFileDirectory)winsrc\lgalloc;$(MSBuildThisFileDirectory)winsrc\platform;$(MSBuildThisFileDirectory)winsrc\sound;$(MSBuildThisFileDirectory)3rdparty\blast;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <StructMemberAlignment>1Byte</StructMemberAlignment>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(EnableSquirrel)' == 'true'">DARK_ENABLE_SQUIRREL=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The renderer uses C99 array designators for sparse dispatch tables.
           MSVC's legacy C mode accepts the syntax but initializes entries
           sequentially, producing corrupt function-pointer tables. -->
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <!-- Embed CodeView records in each object so parallel library builds do
           not race while updating shared compiler PDBs. The linker still emits
           the final executable PDB. -->
      <DebugInformationFormat Condition="'$(Configuration)' != 'Release'">OldStyle</DebugInformationFormat>
      <DebugInformationFormat Condition="'$(Configuration)' == 'Release'">None</DebugInformationFormat>
      <!-- MSVC emits C4073/C4074 solely because the legacy runtime deliberately
           selects early static-initialization segments. Preserve that ordering. -->
      <DisableSpecificWarnings>4073;4074;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
